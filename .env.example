# ── Supabase ──────────────────────────────────────────────────────────────
# Obter em: https://supabase.com/dashboard → seu projeto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SÓ no worker e em route handlers server-side.
# NUNCA expor no client bundle. Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Connection string Postgres (usada pelo pg-boss no worker).
# Supabase: Settings → Database → Connection string (URI, porta 5432/6543)
DATABASE_URL=

# ── Anthropic ─────────────────────────────────────────────────────────────
# Obter em: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Modelo configurável; padrão do MVP:
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Aplicação ─────────────────────────────────────────────────────────────
# E-mail que o seed script promove a admin (aprovação da lista de espera)
ADMIN_EMAIL=

# URL pública do app (Vercel em prod; http://localhost:3000 em dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
