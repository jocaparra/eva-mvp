# Anthropic (Claude) — LLM principal
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Embeddings RAG (Anthropic não oferece; Voyage é o parceiro recomendado)
VOYAGE_API_KEY=pa-...
VOYAGE_EMBEDDING_MODEL=voyage-3-lite
TAVILY_API_KEY=tvly-...
PRESENTON_API_KEY=sk-presenton-...
# Canva Connect (enterprise brand templates) — se configurado, tem prioridade sobre Presenton
CANVA_API_KEY=
CANVA_BRAND_TEMPLATE_ID=
ZAPI_INSTANCE_ID=seu_instance_id
ZAPI_TOKEN=seu_token_zapi
ZAPI_CLIENT_TOKEN=seu_client_token
BASE_URL=https://seu-app.railway.app
PRIVACY_POLICY_URL=https://oxai.online/privacidade
# Optional: force a Yahoo Finance ticker (e.g. PETR4.SA, AAPL)
YAHOO_FINANCE_TICKER=
# WhatsApp dev: allow all numbers without subscription
WHATSAPP_OPEN_ACCESS=true
# Optional: comma-separated allowed phones when SUPABASE_URL is set
WHATSAPP_ALLOWED_PHONES=
MONTHLY_JOB_LIMIT=30
# --- Opcional: Supabase (não é banco de produto; ver README) ---
# Usado apenas para: painel Arquivos (/files), assinaturas WhatsApp, ARTIFACT_STORAGE=supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=eyJ...
JWT_SECRET_KEY=gerar_string_aleatoria_32_chars
# Obrigatório em produção — única dependência de banco para deals, jobs, conversas e RAG
# SQLite local (eva_workspace.db) se omitido em dev.
DATABASE_URL=
# Modelo de embedding Voyage (768 dims compatíveis com pgvector existente)
# Object storage de artefatos gerados: local | supabase | s3
ARTIFACT_STORAGE=local
ARTIFACT_STORAGE_LOCAL_PATH=./artifact_storage
# Supabase Storage (quando ARTIFACT_STORAGE=supabase) — bucket dedicado a artefatos
ARTIFACT_STORAGE_SUPABASE_BUCKET=artefatos
# S3 (quando ARTIFACT_STORAGE=s3)
ARTIFACT_STORAGE_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Railway: monte um volume em /data e use os paths abaixo (artefatos + PDFs do data room)
# DEAL_UPLOAD_PATH=/data/uploads/deal_workspace
# ARTIFACT_STORAGE_LOCAL_PATH=/data/artifact_storage
